# ---------------------------------------------------------------------------
# Backend (server/) — set these wherever the Express server runs (Replit)
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port the Express server listens on.
PORT=5000

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=change-me

# Origins allowed to call this API, comma separated, full origin with scheme
# and no trailing slash. Add your deployed web app here, e.g. the Vercel URL.
# Replit domains and localhost are allowed automatically.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Vercel preview deployments get a fresh *.vercel.app host each time and are
# allowed by default. Set to "false" to restrict to ALLOWED_ORIGINS only.
ALLOW_VERCEL_PREVIEWS=true


# ---------------------------------------------------------------------------
# Frontend (Expo web) — set this wherever the web bundle is BUILT (Vercel)
# ---------------------------------------------------------------------------

# Host of the backend API, without a trailing slash. Metro inlines this into
# the bundle at build time, so changing it requires a rebuild, not a restart.
# Local dev:  localhost:5000
# Production: your-backend.replit.app
EXPO_PUBLIC_DOMAIN=localhost:5000
